#!/bin/sh

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
  exit 0
fi

blocked=$(printf '%s\n' "$staged" | grep -Ei '(^|/)\.env($|\.)|\.(jks|keystore|p12|pfx|pem|key)$' | grep -Ev '(^|/)\.env\.example$')
if [ -n "$blocked" ]; then
  echo "ERROR: 检测到敏感文件，已阻止提交：" >&2
  printf '%s\n' "$blocked" >&2
  exit 1
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact
  exit $?
fi

pattern='(AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[0-9A-Za-z-]+|-----BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY-----)'
if git diff --cached -U0 | grep -E '^\+' | grep -Eiq "$pattern"; then
  echo "ERROR: 检测到疑似密钥内容，已阻止提交。安装 gitleaks 可获得更全面扫描。" >&2
  exit 1
fi

exit 0
